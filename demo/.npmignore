# NOTE: wasm-pack writes pkg/.gitignore containing `*`, and npm's
# ignore-walk honors subdirectory .gitignore files, so that single file
# hid the entire built engine from the tarball (1.0.1 shipped without
# pkg/). The build scripts delete it after every build (`rm -f
# pkg/.gitignore`); do NOT re-add it. This file stays permissive so
# everything in package.json files[] ships. Keep node_modules out.
node_modules
