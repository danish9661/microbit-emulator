{
  "name": "microbit-emu",
  "version": "0.1.0",
  "description": "BBC micro:bit v2.2 emulator core (nRF52833 WASM) + virtual parts for Wokwi-style setups. Boot real firmware in the browser: MicroPython REPL, MakeCode builds, 5x5 LED matrix, sensors, BLE SoftDevice face.",
  "keywords": [
    "microbit",
    "micro-bit",
    "bbc-microbit",
    "nrf52833",
    "nrf52",
    "nordic",
    "emulator",
    "simulator",
    "cortex-m4",
    "webassembly",
    "wasm",
    "micropython",
    "makecode",
    "ble",
    "bluetooth-low-energy"
  ],
  "homepage": "https://danish9661.github.io/microbit-emulator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danish9661/microbit-emulator.git"
  },
  "bugs": {
    "url": "https://github.com/danish9661/microbit-emulator/issues"
  },
  "type": "module",
  "files": [
    "pkg/",
    "parts/",
    "firmware/",
    "assets/",
    "index.html",
    "doc.html",
    "about.html",
    "bench.css",
    "robots.txt",
    "sitemap.xml",
    "API.md",
    "README.md"
  ],
  "scripts": {
    "test:parts": "node parts/smoke.mjs",
    "test:handshake": "node parts/handshake.mjs",
    "test:mpy": "node parts/ble_lang/run_mpy_face.mjs",
    "test:js": "node parts/ble_lang/run_js_face.mjs",
    "test:py": "node parts/ble_lang/run_py_face.mjs",
    "test:repl": "node parts/ble_lang/run_mpy_repl.mjs",
    "test:mpy-radio": "node parts/ble_lang/run_mpy_radio.mjs",
    "test:ts": "node --experimental-strip-types parts/ble_lang/ts_lang_face.mts",
    "test:js-example": "node parts/ble_lang/gpio_js_example.mjs",
    "test:ts-example": "node --experimental-strip-types parts/ble_lang/gpio_ts_example.mts",
    "test:live": "node parts/ble_live_e2e.mjs",
    "test:wasm": "npm run test:handshake && npm run test:parts && npm run test:mpy && npm run test:js && npm run test:py && npm run test:ts && npm run test:repl && npm run test:mpy-radio && npm run test:js-example && npm run test:ts-example",
    "build:wasm": "wasm-pack build ../nrf52833-periph-wasm --target web --out-dir ../demo/pkg",
    "build:handshake": "wasm-pack build ../nrf52833-periph-wasm --target web --out-dir ../demo/parts/pkg-test-handshake",
    "serve": "python3 -m http.server 8080",
    "bridge": "python3 ../tools/ble_air_bridge.py"
  },
  "license": "MIT"
}
