{
  "name": "microbit-v2-emulator",
  "version": "0.1.0",
  "description": "BBC micro:bit v2.2 emulator core (nRF52833 WASM) + virtual parts for Wokwi-style setups",
  "type": "module",
  "files": [
    "pkg/",
    "parts/",
    "firmware/",
    "index.html",
    "doc.html",
    "about.html",
    "bench.css",
    "API.md",
    "README.md"
  ],
  "scripts": {
    "test:parts": "node parts/smoke.mjs",
    "test:handshake": "node parts/handshake.mjs",
    "test:mpy": "node parts/ble_lang/run_mpy_face.mjs",
    "test:js": "node parts/ble_lang/run_js_face.mjs",
    "test:py": "node parts/ble_lang/run_py_face.mjs",
    "test:repl": "node parts/ble_lang/run_mpy_repl.mjs",
    "test:ts": "node --experimental-strip-types parts/ble_lang/ts_lang_face.mts",
    "test:live": "node parts/ble_live_e2e.mjs",
    "test:wasm": "npm run test:handshake && npm run test:parts && npm run test:mpy && npm run test:js && npm run test:py && npm run test:ts && npm run test:repl",
    "build:wasm": "wasm-pack build ../nrf52833-periph-wasm --target web --out-dir ../demo/pkg",
    "build:handshake": "wasm-pack build ../nrf52833-periph-wasm --target web --out-dir ../demo/parts/pkg-test-handshake",
    "serve": "python3 -m http.server 8080",
    "bridge": "python3 ../tools/ble_air_bridge.py"
  },
  "license": "MIT"
}
